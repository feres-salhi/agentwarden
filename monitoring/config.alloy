local.file_match "agentwarden" {
  path_targets = [{"__path__" = "/var/log/agentwarden/*.jsonl", "job" = "agentwarden"}]
}

loki.source.file "agentwarden" {
  targets    = local.file_match.agentwarden.targets
  forward_to = [loki.process.agentwarden.receiver]
}

loki.process "agentwarden" {
  stage.json {
    expressions = {decision = "", tool = "", time = ""}
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {decision = "", tool = ""}
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}